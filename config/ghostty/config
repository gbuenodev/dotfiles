# Appearance
theme = Kanagawa Wave
font-size = 14

# Behavior
macos-option-as-alt = true
window-save-state = always
confirm-close-surface = false

# Splits
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+j=goto_split:bottom
keybind = super+ctrl+k=goto_split:top
keybind = super+ctrl+l=goto_split:right
keybind = super+shift+enter=toggle_split_zoom

# Tabs
keybind = super+shift+h=previous_tab
keybind = super+shift+l=next_tab

# Hyper key (Caps Lock via Raycast = ctrl+alt+shift+super)
keybind = ctrl+alt+shift+super+j=scroll_page_lines:-3
keybind = ctrl+alt+shift+super+k=scroll_page_lines:3
keybind = ctrl+alt+shift+super+i=increase_font_size:1
keybind = ctrl+alt+shift+super+o=decrease_font_size:1
